-- ============================================================================
-- ROBOT VACUUM CLEANER - COMPLETE FORMAL MODEL & VERIFICATION (CA01 - CA12)
-- Language: Machine-Readable CSP (CSPM) for FDR4
-- Course: Bachelor of Information Systems - Systems Analysis and Design
-- Team 5.2: Ryan, Caua, Wesley, Gabriel Monteiro
-- ============================================================================

-- ----------------------------------------------------------------------------
-- 1. SYSTEM CONSTANTS
-- ----------------------------------------------------------------------------
MAX_BATTERY       = 5   -- Full battery capacity
MIN_START_BATTERY = 2   -- Minimum battery level required to start cleaning
LOW_BATTERY_LIMIT = 1   -- Critical threshold triggering return to base
TOTAL_AREAS       = 2   -- Number of dirty areas to clean in one cycle

-- ----------------------------------------------------------------------------
-- 2. CHANNEL DECLARATIONS
-- ----------------------------------------------------------------------------
-- Initialization
channel power_on
channel init_sensors

-- User Commands
channel cmd_start
channel cmd_pause
channel cmd_resume
channel cmd_cancel

-- Navigation & Obstacle Handling
channel move
channel detect_obstacle
channel avoid_obstacle

-- Dirt Detection & Cleaning Unit
channel detect_dirt
channel start_vacuum
channel clean_area
channel stop_vacuum
channel finish_cleaning

-- Battery Management & Charging Station
channel check_battery
channel battery_ok
channel battery_insufficient
channel battery_low
channel return_to_base
channel dock_at_base
channel start_charge
channel charging
channel charge_complete

-- ----------------------------------------------------------------------------
-- 3. PROCESS DECOMPOSITION
-- ----------------------------------------------------------------------------

-- 3.1 UserInterface: Models valid external user command sequences
UserInterface = power_on -> UI_Idle

UI_Idle =
    cmd_start -> UI_Starting

UI_Starting =
    battery_ok -> UI_Active
    []
    battery_insufficient -> UI_Charging

UI_Active =
    cmd_pause -> UI_Paused
    []
    cmd_cancel -> UI_Idle
    []
    battery_low -> UI_Charging
    []
    finish_cleaning -> UI_Idle

UI_Paused =
    cmd_resume -> UI_Active
    []
    cmd_cancel -> UI_Idle

UI_Charging =
    charge_complete -> UI_Idle

-- 3.2 Navigation: Models movement, obstacle avoidance, and docking
Navigation =
    move -> (
        detect_obstacle -> avoid_obstacle -> Navigation
        []
        Navigation
    )
    []
    return_to_base -> dock_at_base -> Navigation

-- 3.3 CleaningUnit: Models vacuum motor state and mutual exclusion with charging
CleaningUnit = CleaningUnit_Off

CleaningUnit_Off =
    start_vacuum -> CleaningUnit_On
    []
    start_charge -> CleaningUnit_Charging

CleaningUnit_On =
    clean_area -> stop_vacuum -> CleaningUnit_Off
    []
    stop_vacuum -> CleaningUnit_Off

CleaningUnit_Charging =
    charge_complete -> CleaningUnit_Off

-- 3.4 BatteryManager: Monitors energy consumption, thresholds, and recharging
BatteryManager(b) =
    (b >= MIN_START_BATTERY & check_battery -> battery_ok -> BatteryManager(b))
    []
    (b < MIN_START_BATTERY & check_battery -> battery_insufficient -> BatteryCharging(b))
    []
    (b > LOW_BATTERY_LIMIT & move -> BatteryManager(b - 1))
    []
    (b > LOW_BATTERY_LIMIT & clean_area -> BatteryManager(b - 1))
    []
    (b <= LOW_BATTERY_LIMIT & battery_low -> BatteryCharging(b))

BatteryCharging(b) =
    return_to_base -> dock_at_base -> start_charge -> RechargeLoop(b)

RechargeLoop(b) =
    if b < MAX_BATTERY then
        charging -> RechargeLoop(b + 1)
    else
        charge_complete -> BatteryManager(MAX_BATTERY)

-- 3.5 Controller: Central orchestrator coordinating all subsystems
Controller =
    power_on -> init_sensors -> Ctrl_Idle

Ctrl_Idle =
    cmd_start -> check_battery -> (
        battery_ok -> Ctrl_Cleaning(TOTAL_AREAS)
        []
        battery_insufficient -> Ctrl_Returning
    )

Ctrl_Cleaning(0) =
    finish_cleaning -> Ctrl_Idle

Ctrl_Cleaning(areas) =
    move -> (
        detect_obstacle -> avoid_obstacle -> Ctrl_Cleaning(areas)
        []
        detect_dirt -> start_vacuum -> Ctrl_Vacuuming(areas)
        []
        Ctrl_Cleaning(areas)
    )
    []
    battery_low -> Ctrl_Returning
    []
    cmd_pause -> Ctrl_Paused(areas)
    []
    cmd_cancel -> Ctrl_Idle

Ctrl_Vacuuming(areas) =
    clean_area -> stop_vacuum -> Ctrl_Cleaning(areas - 1)
    []
    battery_low -> stop_vacuum -> Ctrl_Returning
    []
    cmd_pause -> stop_vacuum -> Ctrl_Paused(areas)
    []
    cmd_cancel -> stop_vacuum -> Ctrl_Idle

Ctrl_Paused(areas) =
    cmd_resume -> Ctrl_Cleaning(areas)
    []
    cmd_cancel -> Ctrl_Idle

Ctrl_Returning =
    return_to_base -> dock_at_base -> start_charge -> Ctrl_Charging

Ctrl_Charging =
    charging -> Ctrl_Charging
    []
    charge_complete -> Ctrl_Idle

-- ----------------------------------------------------------------------------
-- 4. PARALLEL COMPOSITION & SYNCHRONIZATION INTERFACES
-- ----------------------------------------------------------------------------
SYNC_CTRL_UI = {|
    power_on, cmd_start, cmd_pause, cmd_resume, cmd_cancel,
    battery_ok, battery_insufficient, battery_low,
    finish_cleaning, charge_complete
|}

SYNC_NAV = {|
    move, detect_obstacle, avoid_obstacle,
    return_to_base, dock_at_base
|}

SYNC_CLEAN = {|
    start_vacuum, clean_area, stop_vacuum,
    start_charge, charge_complete
|}

SYNC_BAT = {|
    check_battery, battery_ok, battery_insufficient, battery_low,
    move, clean_area,
    return_to_base, dock_at_base,
    start_charge, charging, charge_complete
|}

SYS_UI    = Controller [| SYNC_CTRL_UI |] UserInterface
SYS_NAV   = SYS_UI     [| SYNC_NAV     |] Navigation
SYS_CLEAN = SYS_NAV    [| SYNC_CLEAN   |] CleaningUnit
SYSTEM    = SYS_CLEAN  [| SYNC_BAT     |] BatteryManager(MAX_BATTERY)

-- Visible system hiding internal sensor/check events (for CA10)
INTERNAL_EVENTS = {| check_battery, detect_dirt |}
SYSTEM_VISIBLE  = SYSTEM \ INTERNAL_EVENTS

-- ----------------------------------------------------------------------------
-- 5. FORMAL SPECIFICATIONS & FDR4 ASSERTIONS (CA01 - CA12)
-- ----------------------------------------------------------------------------

-- CA01: No cleaning before cmd_start
SPEC_CA01_IDLE =
    cmd_start -> SPEC_CA01_STARTED
    []
    ([] e : diff(Events, {| cmd_start, start_vacuum, clean_area |}) @ e -> SPEC_CA01_IDLE)

SPEC_CA01_STARTED =
    finish_cleaning -> SPEC_CA01_IDLE
    []
    cmd_cancel -> SPEC_CA01_IDLE
    []
    battery_low -> SPEC_CA01_IDLE
    []
    battery_insufficient -> SPEC_CA01_IDLE
    []
    ([] e : diff(Events, {| finish_cleaning, cmd_cancel, battery_low, battery_insufficient |}) @ e -> SPEC_CA01_STARTED)

assert SPEC_CA01_IDLE [T= SYSTEM

-- CA02: No movement or vacuuming while paused
SPEC_CA02_ACTIVE =
    cmd_pause -> SPEC_CA02_PAUSED
    []
    ([] e : diff(Events, {| cmd_pause |}) @ e -> SPEC_CA02_ACTIVE)

SPEC_CA02_PAUSED =
    cmd_resume -> SPEC_CA02_ACTIVE
    []
    cmd_cancel -> SPEC_CA02_ACTIVE
    []
    stop_vacuum -> SPEC_CA02_PAUSED

assert SPEC_CA02_ACTIVE [T= SYSTEM

-- CA03: Interrupt cleaning when low battery is detected
SPEC_CA03_NORMAL =
    battery_low -> SPEC_CA03_INTERRUPTED
    []
    ([] e : diff(Events, {| battery_low |}) @ e -> SPEC_CA03_NORMAL)

SPEC_CA03_INTERRUPTED =
    charge_complete -> SPEC_CA03_NORMAL
    []
    ([] e : diff(Events, {| charge_complete, move, start_vacuum, clean_area |}) @ e -> SPEC_CA03_INTERRUPTED)

assert SPEC_CA03_NORMAL [T= SYSTEM

-- CA04: Return to charging station when battery reaches minimum limit
SPEC_CA04_TRACE =
    battery_low -> SPEC_CA04_TRACE_RET
    []
    ([] e : diff(Events, {| battery_low |}) @ e -> SPEC_CA04_TRACE)

SPEC_CA04_TRACE_RET =
    return_to_base -> dock_at_base -> SPEC_CA04_TRACE
    []
    stop_vacuum -> return_to_base -> dock_at_base -> SPEC_CA04_TRACE

SPEC_CA04_F =
    (STOP |~| ([] e : diff(Events, {| battery_low |}) @ e -> SPEC_CA04_F))
    |~|
    (battery_low -> SPEC_CA04_MUST_RETURN)

SPEC_CA04_MUST_RETURN =
    (return_to_base -> dock_at_base -> SPEC_CA04_F)
    |~|
    (stop_vacuum -> return_to_base -> dock_at_base -> SPEC_CA04_F)

assert SPEC_CA04_TRACE [T= SYSTEM
assert SPEC_CA04_F     [F= SYSTEM

-- CA05: Vacuum mechanism cannot remain active during recharge
SPEC_CA05_VAC_OFF =
    start_vacuum -> SPEC_CA05_VAC_ON
    []
    start_charge -> SPEC_CA05_CHARGING
    []
    ([] e : diff(Events, {| start_vacuum, clean_area, start_charge |}) @ e -> SPEC_CA05_VAC_OFF)

SPEC_CA05_VAC_ON =
    stop_vacuum -> SPEC_CA05_VAC_OFF
    []
    ([] e : diff(Events, {| stop_vacuum, start_charge, charging |}) @ e -> SPEC_CA05_VAC_ON)

SPEC_CA05_CHARGING =
    charge_complete -> SPEC_CA05_VAC_OFF
    []
    ([] e : diff(Events, {| charge_complete, start_vacuum, clean_area |}) @ e -> SPEC_CA05_CHARGING)

assert SPEC_CA05_VAC_OFF [T= SYSTEM

-- CA06: Execute obstacle avoidance immediately after detecting an obstacle
SPEC_CA06_TRACE =
    detect_obstacle -> avoid_obstacle -> SPEC_CA06_TRACE
    []
    ([] e : diff(Events, {| detect_obstacle |}) @ e -> SPEC_CA06_TRACE)

SPEC_CA06_F =
    (STOP |~| ([] e : diff(Events, {| detect_obstacle |}) @ e -> SPEC_CA06_F))
    |~|
    (detect_obstacle -> avoid_obstacle -> SPEC_CA06_F)

assert SPEC_CA06_TRACE [T= SYSTEM
assert SPEC_CA06_F     [F= SYSTEM

-- CA07: Cannot start a new cleaning with insufficient battery
SPEC_CA07_OK =
    battery_insufficient -> SPEC_CA07_BLOCKED
    []
    ([] e : diff(Events, {| battery_insufficient |}) @ e -> SPEC_CA07_OK)

SPEC_CA07_BLOCKED =
    charge_complete -> SPEC_CA07_OK
    []
    ([] e : diff(Events, {| charge_complete, move, start_vacuum, clean_area, battery_ok |}) @ e -> SPEC_CA07_BLOCKED)

SPEC_NO_INSUFFICIENT =
    [] e : diff(Events, {| battery_insufficient |}) @ e -> SPEC_NO_INSUFFICIENT

assert SPEC_CA07_OK [T= SYSTEM
assert not SPEC_NO_INSUFFICIENT [T= SYSTEM

-- CA08: Allow resuming a paused operation if not cancelled
SPEC_CA08_F =
    (STOP |~| ([] e : diff(Events, {| cmd_pause, cmd_resume |}) @ e -> SPEC_CA08_F))
    |~|
    (cmd_pause -> SPEC_CA08_PAUSED)

SPEC_CA08_PAUSED =
    SPEC_CA08_READY_RESUME
    |~|
    (stop_vacuum -> SPEC_CA08_READY_RESUME)

SPEC_CA08_READY_RESUME =
    (cmd_resume -> SPEC_CA08_F)
    []
    (STOP |~| (cmd_cancel -> SPEC_CA08_F))

assert SPEC_CA08_F [F= SYSTEM

-- CA09: Deadlock freedom
assert SYSTEM :[deadlock free [F]]
assert SYSTEM :[deadlock free [FD]]

-- CA10: Divergence freedom
assert SYSTEM         :[divergence free]
assert SYSTEM_VISIBLE :[divergence free]

-- CA11: Emit completion event after cleaning all areas
SPEC_CA11_IDLE =
    (STOP |~| ([] e : diff(Events, {| cmd_start, finish_cleaning |}) @ e -> SPEC_CA11_IDLE))
    |~|
    (cmd_start -> SPEC_CA11_STARTING)

SPEC_CA11_STARTING =
    STOP |~| (check_battery -> (
        (STOP |~| (battery_ok -> SPEC_CA11_CLEANING(TOTAL_AREAS)))
        |~|
        (STOP |~| (battery_insufficient -> SPEC_CA11_IDLE))
    ))

SPEC_CA11_CLEANING(0) =
    stop_vacuum -> finish_cleaning -> SPEC_CA11_IDLE

SPEC_CA11_CLEANING(n) =
    (STOP |~| ([] e : diff(Events, {| clean_area, finish_cleaning, cmd_cancel, battery_low |}) @ e -> SPEC_CA11_CLEANING(n)))
    |~|
    (STOP |~| (clean_area -> SPEC_CA11_CLEANING(n - 1)))
    |~|
    (STOP |~| (cmd_cancel -> SPEC_CA11_IDLE))
    |~|
    (STOP |~| (battery_low -> SPEC_CA11_IDLE))

SPEC_NO_FINISH =
    [] e : diff(Events, {| finish_cleaning |}) @ e -> SPEC_NO_FINISH

assert SPEC_CA11_IDLE [F= SYSTEM
assert not SPEC_NO_FINISH [T= SYSTEM

-- CA12: Parallel composition and synchronization consistency
SPEC_CA12_INIT =
    power_on -> init_sensors -> SPEC_CA12_RUN

SPEC_CA12_RUN =
    return_to_base -> dock_at_base -> start_charge -> SPEC_CA12_CHARGING
    []
    ([] e : diff(Events, {| power_on, init_sensors, return_to_base, dock_at_base, start_charge, charging, charge_complete |}) @ e -> SPEC_CA12_RUN)

SPEC_CA12_CHARGING =
    charging -> SPEC_CA12_CHARGING
    []
    charge_complete -> SPEC_CA12_RUN

assert SPEC_CA12_INIT [T= SYSTEM
